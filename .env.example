# =============================================================================
# .env.example — Derivatives Pricing Engine
# Copy to .env and fill in real values.  Never commit .env to git.
# =============================================================================

# ── Deriv API (live market data via Deriv WebSocket API) ─────────────────────
DERIV_API_KEY=your_deriv_api_key_here
DERIV_APP_ID=your_deriv_app_id_here

# ── Redis (shared market data cache) ─────────────────────────────────────────
# Format: redis://[username:password@]host:port/db
# Default when running docker-compose locally:
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb
# REDIS_PASSWORD=                     # leave blank for local dev

# ── Cache TTLs (seconds) ─────────────────────────────────────────────────────
CACHE_TTL_L1=30                       # in-process memory cache (per worker)
CACHE_TTL_L2=300                      # Redis short TTL  (quotes, options, IV)
CACHE_TTL_L3=3600                     # Redis long  TTL  (OHLCV history, news)

# ── FastAPI server ────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR

# ── Rate limiting ─────────────────────────────────────────────────────────────
MAX_CONCURRENT_REQUESTS=1000
RATE_LIMIT_PER_SECOND=10

# ── OpenBB Platform (optional — pip install openbb) ──────────────────────────
# Set your PAT from https://my.openbb.co/app/platform/pat
# OPENBB_PAT=your_openbb_personal_access_token

# ── yfinance (no key needed — uses public Yahoo Finance API) ─────────────────
# No credentials required.

# ── Database (Transact service — docker-compose.dev.yml) ─────────────────────
DATABASE_URL=postgresql://transact:transact_dev@localhost:5432/transact

# ── Security (optional, for production API auth) ─────────────────────────────
# SECRET_KEY=your_jwt_secret_key_here
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Monitoring / Observability ────────────────────────────────────────────────
# SENTRY_DSN=https://xxx@sentry.io/yyy
# PROMETHEUS_PORT=9090

# ── Frontend (Vite — set separately in frontend/.env) ────────────────────────
# VITE_API_URL=http://localhost:8000
# VITE_ENV=development
# VITE_ENABLE_DEMO=true
