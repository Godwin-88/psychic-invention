# Copy to .env and fill in. Never commit .env.

# ── Runtime ───────────────────────────────────────────────────────────────────
# production: refuses to start on the Python reference engine and makes
# protected endpoints fail closed until API keys are configured.
APP_ENV=development
# ALLOW_MOCK_ENGINE=false        # production override (not recommended)

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated keys. Admin keys also carry the write scope.
# write: POST /blotter/trade
# admin: cache flush, /agents/enrich, GET /marketplace/registrations (PII)
WRITE_API_KEYS=
ADMIN_API_KEYS=
# Explicit origins only ("*" is rejected)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Persistence ───────────────────────────────────────────────────────────────
# Set for a shared, durable blotter (required with more than one worker:
# the in-memory blotter is per process).
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/transact

# ── Redis cache ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_L1=30
CACHE_TTL_L2=300
CACHE_TTL_L3=3600

# ── Market data ───────────────────────────────────────────────────────────────
DERIV_API_KEY=
DERIV_APP_ID=
# OPENBB_PAT=
# NAUTILUS_CATALOG_PATH=

# ── Agents / knowledge base (optional) ────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
# GROQ_API_KEY=                  # if set, Groq is used instead of Ollama
AGENT_RATE_LIMIT_PER_MIN=20
